{
  "mode": "Indexed",
  "policyRule": {
    "if": {
      "allOf": [
        {
          "field": "type",
          "equals": "Microsoft.Storage/storageAccounts"
        },
        {
          "field": "name",
          "like": "st*"
        },
        {
          "field": "name",
          "contains": "arch"
        },
        {
          "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
          "notEquals": "Disabled"
        },
        {
          "anyOf": [
            {
              "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
              "notEquals": "Enabled"
            },
            {
              "field": "Microsoft.Storage/storageAccounts/networkAcls.defaultAction",
              "notEquals": "Deny"
            },
            {
              "count": {
                "field": "Microsoft.Storage/storageAccounts/networkAcls.virtualNetworkRules[*]"
              },
              "greater": 0
            },
            {
              "count": {
                "field": "Microsoft.Storage/storageAccounts/networkAcls.ipRules[*]"
              },
              "greater": 0
            },
            {
              "count": {
                "field": "Microsoft.Storage/storageAccounts/networkAcls.ipv6Rules[*]"
              },
              "greater": 0
            },
            {
              "field": "Microsoft.Storage/storageAccounts/networkAcls.bypass",
              "notEquals": "None"
            },
            {
              "count": {
                "field": "Microsoft.Storage/storageAccounts/networkAcls.resourceAccessRules[*]",
                "where": {
                  "field": "Microsoft.Storage/storageAccounts/networkAcls.resourceAccessRules[*].resourceId",
                  "notContains": "/providers/Microsoft.Kusto/clusters/"
                }
              },
              "greater": 0
            }
          ]
        }
      ]
    },
    "then": {
      "effect": "Deny"
    }
  },
  "parameters": {}
}